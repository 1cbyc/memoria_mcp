# Memoria — environment for the HTTP transport (docker compose reads this file).
# Copy to .env and fill in. Never commit .env.
#
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"   # API key / OAuth secret
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"         # encryption key (64 hex)

# Bearer token for /mcp, /ingest and /dashboard/api. Required for HTTP.
MEMORIA_API_KEY=

# OAuth client secret for claude.ai / remote MCP clients. Keep it DISTINCT from
# the API key so rotating one does not rotate the other. Required when BIND_ALL=true.
MEMORIA_OAUTH_CLIENT_SECRET=

# AES-256-GCM master key (64 hex chars) for the collector's encrypted buffer and
# credential store. Required when BIND_ALL=true. Rotating it makes existing
# ciphertext unreadable.
MEMORIA_ENCRYPTION_KEY=

# External URL of this server. Pins the OAuth discovery metadata so it is never
# derived from the (attacker-influenceable) Host header. Required when exposed.
MEMORIA_PUBLIC_URL=http://localhost:3100

# Optional: OpenAI embeddings (text-embedding-3-small). The key alone does NOT
# enable remote embeddings: only MEMORIA_EMBEDDINGS=openai does, and then
# memory content and search queries are sent to OpenAI. Otherwise Memoria uses
# the local all-MiniLM-L6-v2 model (one-time ~23 MB download), then n-gram hashing.
OPENAI_API_KEY=

# Optional: embedding provider override — auto | openai | minilm | hash
# MEMORIA_EMBEDDINGS=auto

# Optional: require a dashboard session or the API key at /authorize, so a
# leaked OAuth client secret alone cannot obtain a token.
# MEMORIA_AUTHORIZE_REQUIRE_APPROVAL=true

# Optional: where the memory store lives (default ~/.memoria locally, /data/memoria in Docker).
# MEMORIA_DIR=

# Optional: bind docker's published port to another interface (default loopback only).
# HOST_BIND=127.0.0.1
