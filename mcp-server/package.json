{
  "name": "@agrippa87/memoria-mcp",
  "version": "0.3.0",
  "description": "Memoria — persistent, plain-text memory for Claude over MCP. Markdown files you own, hybrid semantic + keyword search, OAuth 2.1 remote transport, and agentic self-maintenance.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memoria-mcp": "dist/index.js",
    "memoria-mcp-http": "dist/http.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agripp87/memoria_mcp.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/Agripp87/memoria_mcp#readme",
  "bugs": {
    "url": "https://github.com/Agripp87/memoria_mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "node scripts/demo.mjs",
    "demo:gen": "node scripts/generate-demo-data.mjs",
    "prepublishOnly": "npm run build",
    "verify:vectors": "node scripts/verify-vector-space.mjs",
    "eval": "node eval/run.mjs",
    "eval:hash": "node eval/run.mjs --hash"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "claude",
    "claude-code",
    "agent-memory",
    "markdown",
    "sqlite",
    "fts5",
    "embeddings"
  ],
  "author": "Agripp87",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/markdown-it": "^14.2.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "js-yaml": "^5.4.2",
    "markdown-it": "^15.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
