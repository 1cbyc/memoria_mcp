# Derived and runtime state. The Markdown under memories/ is the source of
# truth; everything below is rebuildable or device-local, and some of it is
# secret. None of it belongs in the repo.
data/
.sync.log
.last-sync
.sync-push-pending

# The object-storage mirror hook, if you use one: it tends to hold bucket
# names and account details specific to one person.
.memoria-mirror.sh

# Code never belongs in a memory store. Collector adapters can load packages
# from a node_modules here, and earlier Memoria versions put one at the root.
node_modules/
package.json
package-lock.json
